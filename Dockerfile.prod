# ---- Stage 1: build the static site ----
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
# Only what Vite builds from: the pipeline's data and renders never enter the image.
COPY index.html vite.config.js ./
COPY src ./src
COPY public ./public
RUN npm run build

# ---- Stage 2: serve dist/ ----
# A static site (hash router, no server code), so nginx serves the files as they are.
FROM nginx:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
